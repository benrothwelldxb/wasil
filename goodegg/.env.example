# Be a Good Egg — environment configuration
# Copy to .env.local (frontend) / set on your host (server). NEVER commit secrets.

# ---------------------------------------------------------------------------
# FRONTEND (build-time, baked into the bundle by Vite)
# ---------------------------------------------------------------------------
# Which backend the app talks to:
#   "local"    — in-browser seeded demo backend (no server needed). Great for review.
#   "api"      — the self-hosted Hono API in /server (Railway, Fly, a VPS, …).
#   "supabase" — a Supabase project (Postgres + Auth + RLS + edge function).
VITE_DATA_PROVIDER=local

# Only for VITE_DATA_PROVIDER=api. Defaults to "/api" (same origin as the API
# service, which is the recommended single-service Railway setup).
# VITE_API_BASE=/api

# Only for VITE_DATA_PROVIDER=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER (the /server Hono API — Railway / self-hosting). NOT exposed to the browser.
# ---------------------------------------------------------------------------
# Postgres connection string. On Railway, add a Postgres plugin and reference it
# (Railway sets DATABASE_URL for you). Set DATABASE_SSL=true if your provider
# requires TLS (most managed Postgres do; Railway's private network does not).
DATABASE_URL=
# DATABASE_SSL=true

# Secret used to sign session tokens and salt sign-in codes. REQUIRED in
# production. Generate: `openssl rand -hex 32`
JWT_SECRET=

# Port the server listens on (Railway sets this automatically).
PORT=8080

# Email delivery for the 6-digit sign-in codes. If RESEND_API_KEY is unset the
# code is printed to the server log (dev mode) — fine for a first run, not for
# real users. Get a key at https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM=Be a Good Egg <onboarding@yourdomain.com>

# Seed a demo group ("The Good Eggs 2026") on first boot so a fresh deployment
# can be reviewed by signing in as ben@work.example.
# SEED_DEMO=true

# Local dev without Postgres: run the server on an in-process database.
# USE_PGLITE=true
# PGLITE_PATH=./.pglite   # optional: persist between restarts
