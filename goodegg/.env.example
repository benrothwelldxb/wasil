# Be a Good Egg — environment configuration
# Copy to .env.local and fill in. NEVER commit real secrets.

# Which backend the app talks to.
#   "local"    — in-browser seeded demo backend (no Supabase needed). Great for review.
#   "supabase" — real Supabase project (requires the two values below).
VITE_DATA_PROVIDER=local

# Supabase project (only needed when VITE_DATA_PROVIDER=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only (Supabase Edge Functions). Set as function secrets,
# NOT exposed to the browser. Listed here for documentation only.
# SUPABASE_SERVICE_ROLE_KEY=
