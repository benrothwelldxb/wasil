{
  "name": "be-a-good-egg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Be a Good Egg — run year-long Secret Buddy schemes at work. Little surprises. Big smiles.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:screenshots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.0.21",
    "@fontsource-variable/inter": "^5.0.18",
    "@hono/node-server": "^2.1.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.51.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.2",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "lucide-react": "^0.417.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1",
    "tailwind-merge": "^2.4.0",
    "tsx": "^4.23.12",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.8",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-pwa": "^0.20.1",
    "vitest": "^2.0.3"
  }
}
