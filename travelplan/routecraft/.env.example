# RouteCraft environment configuration
#
# ALL variables below are OPTIONAL. Every one has a safe default, so CI and
# Cloudflare Pages build correctly with no .env file at all. Copy this file
# to `.env.local` only when you need to override a default for local dev.
#
# Validation lives in src/config/env.ts (Zod-backed, fail-fast at boot).
# See docs/conventions/env.md for the full contract.

# App environment. One of: development | staging | production.
# Default: 'development' in `vite dev`, 'production' in a `vite build`.
# VITE_APP_ENV=development

# Base URL the HTTP client targets. Either an absolute URL
# (e.g. https://api.example.com) or a '/'-rooted path (e.g. /api).
# Default: '/api'
# VITE_API_BASE_URL=/api

# Minimum log level emitted by the app logger.
# One of: debug | info | warn | error | silent.
# Default: 'debug' in dev, 'warn' in production.
# VITE_LOG_LEVEL=debug

# Comma-separated feature flag list. Prefix a flag with '!' to force it off
# (e.g. `newNav,!betaTable`). Default: '' (no flags set).
# VITE_FLAGS=

# Free-form build/release version string surfaced in the UI and logs.
# Default: 'dev'
# VITE_APP_VERSION=dev
