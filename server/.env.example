# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wasil?schema=public"

# Session
SESSION_SECRET="your-super-secret-session-key-change-in-production"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Microsoft OAuth
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_TENANT_ID="common"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Server
PORT=4000
NODE_ENV=development

# Wasil Hub SSO (ecosystem identity provider)
# All optional-with-defaults so dev/tests run without them. Hub mints a
# 5-minute RS256 JWT and redirects to /auth/hub/exchange?hub_token=<JWT>.
#
# HOST-SPECIFIC — the code defaults below are `hub.wasil.app` (Hub's own default
# too), but a real Hub deployment may sit elsewhere: this one is wasilhub.app.
# Set these from the Hub you are actually pointing at. HUB_ISSUER must equal the
# `iss` Hub really signs, character for character.
HUB_URL="https://wasilhub.app"           # Hub base URL (used to derive JWKS URL)
HUB_ISSUER="https://wasilhub.app"        # expected JWT `iss` — a full URL, never a bare name
HUB_AUDIENCE="wasil-connect"             # expected JWT `aud`
# HUB_JWKS_URL="https://wasilhub.app/.well-known/jwks.json"   # optional override; defaults to ${HUB_URL}/.well-known/jwks.json
# HUB_LAUNCH_URL="https://wasilhub.app/launch/connect"        # where to send unauthenticated staff to (re-)enter via Hub

# Wasil Hub MIS sync (Stage 2 — pull pupils/staff/classes/year-groups)
# HUB_MIS_URL="https://wasilhub.app"       # Hub MIS API base; defaults to ${HUB_URL}, then to the
#                                          # code default https://hub.wasil.app — which is NOT this
#                                          # deployment, so rely on HUB_URL rather than the fallback.
# HUB_SERVICE_TOKEN="wsk_..."              # per-app Bearer service token (issued; set in production — the
#                                          # roster sync runs on it). Unset, the sync throws a clear
#                                          # "service token not configured" error rather than failing oddly.
# HUB_WEBHOOK_SECRET="..."                 # shared secret for verifying X-Wasil-Signature on POST /api/hub/webhook

# Wasil Inclusion (SEND) — guardian API, for the parent-facing Inclusion page.
# Connect READS a child's published IEP, therapy sessions and documents from
# Inclusion; Inclusion owns that data and Connect stores none of it. Nothing
# calls this yet — the guardian endpoints are still being built on their side,
# and the credential is set first on purpose so a missing one surfaces as a
# configuration error rather than as a half-built feature failing strangely.
#
# HOST-SPECIFIC, and the same trap as HUB_MIS_URL above: Inclusion's own source
# defaults to `app.wasilinclusion.com`, which is NOT this deployment. Take the
# value from here, never from their code default. (Confirmed from the running
# config, 11 Sep 2026.)
# SEND_API_URL="https://www.wasilinclusion.com"
# SEND_SERVICE_TOKEN="wsk_..."             # Bearer service token, same scheme as Hub's. NOT school-scoped:
#                                          # one credential, with the school named per request, so a school
#                                          # joining or leaving never means a credential change. Rotation
#                                          # honours the previous value for 24h, so rotate-then-deploy is
#                                          # safe. Every rejection looks identical by design — a 401 will not
#                                          # tell you whether the token is absent, malformed, unknown or
#                                          # revoked, so check the value here before debugging the caller.
